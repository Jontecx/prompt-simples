# URL canônica do portal (sem barra no final)
NEXT_PUBLIC_SITE_URL=https://promptsimples.com.br

# E-mail institucional exibido na página /contato e rodapé
NEXT_PUBLIC_CONTACT_EMAIL=contato@promptsimples.com.br

# ID do cliente Google AdSense (ex: ca-pub-1234567890123456)
# Deixe vazio antes da aprovação para colapsar os espaços de anúncio sem caixas cinzas
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# IDs opcionais dos slots AdSense criados no painel do Google
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# Webhook (ex: n8n) para receber leads da Newsletter e mensagens do formulário de Contato
NEXT_PUBLIC_CONTACT_WEBHOOK_URL=

# ID opcional de medição do Google Analytics 4 (ex: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
